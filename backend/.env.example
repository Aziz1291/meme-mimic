# Copy this file to .env and fill in your values. .env is never committed.

# mock = offline, fixed answers (default) | real = calls Groq (needs GROQ_API_KEY)
INFERENCE_MODE=mock

# Your Groq key from console.groq.com (leave empty in mock mode)
GROQ_API_KEY=

# The LLM used by the coach in real mode (check console.groq.com/settings/limits)
LLM_MODEL=qwen/qwen3.8-27b

# "signal" = the real scorer (default); "mock" = always 0.8, to test the game quickly
SCORER=signal
